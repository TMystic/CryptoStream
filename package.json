{
  "name": "cryptostream",
  "version": "2.0.0",
  "private": true,
  "description": "CryptoStream — a decentralised video streaming service with on-chain access control",
  "workspaces": [
    "client",
    "server",
    "contracts"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=client",
    "start": "npm run start --workspace=server",
    "test": "npm run test --workspaces --if-present",
    "compile": "npm run compile --workspace=contracts",
    "deploy:contracts": "npm run deploy --workspace=contracts"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": ">=18.17"
  }
}
