# ==============================================================
# CryptoStream — environment variables
# Copy to `.env` in the repo root and fill in your values.
# ==============================================================

# ---------- Server (Express) ----------

# Port the API listens on (default: 3000)
PORT=3000

# Comma-separated browser origins allowed to call the API
CORS_ORIGIN=http://localhost:5173

# MongoDB connection string
MONGO_SERVER=mongodb+srv://<user>:<password>@cluster.mongodb.net/cryptostream

# Firebase Admin SDK (Firebase console -> Project settings -> Service accounts -> Generate new private key)
# Encode the private key as base64 (recommended) OR paste it raw using \n for line breaks
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY_BASE64=
# FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n....\n-----END PRIVATE KEY-----\n
FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# Server-side RPC used to verify registrations and playback access
RPC_URL=https://sepolia.infura.io/v3/your-key
CHAIN_ID=11155111
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
# Funded Sepolia wallet used only to sponsor upload/purchase gas (never expose as VITE_*)
RELAYER_PRIVATE_KEY=

# ---------- Client (React + Vite) ----------

# Deployed StreamingService contract address
VITE_CONTRACT_ADDRESS=0xa25d735b938FE3d565F38f49e33e9e0f483bD30E
VITE_CHAIN_ID=11155111
VITE_CHAIN_NAME=Sepolia

# API base URL (leave empty to use the Vite dev proxy at /api)
VITE_API_URL=
